{
    "name": "@tiksee/core",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint src",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "@tiksee/config": "workspace:*",
        "@typescript/native": "catalog:",
        "eslint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
