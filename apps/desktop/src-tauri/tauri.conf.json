{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "TikSee",
    "version": "0.1.0",
    "identifier": "ro.codai.tiksee",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://127.0.0.1:5373",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "TikSee",
                "width": 1280,
                "height": 820,
                "minWidth": 880,
                "minHeight": 600,
                "resizable": true,
                "center": true,
                "decorations": false,
                "transparent": true,
                "shadow": true,
                "dragDropEnabled": false,
                "visible": false
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "font-src": "'self' data:",
                "img-src": "'self' data: blob: https:",
                "connect-src": "'self' ws://127.0.0.1:* http://127.0.0.1:* wss://*.openai.azure.com https://*.openai.azure.com",
                "media-src": "'self' blob: data:"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "resources": [],
        "externalBin": [],
        "windows": {
            "nsis": {
                "installMode": "perMachine"
            }
        }
    },
    "plugins": {}
}