{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "TikSee",
    "version": "0.5.1",
    "identifier": "ro.codai.tiksee",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://127.0.0.1:15373",
        "beforeBuildCommand": "pnpm build && pnpm sidecar:exe && pnpm vcam:build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "TikSee",
                "width": 1280,
                "height": 820,
                "minWidth": 880,
                "minHeight": 600,
                "resizable": true,
                "center": true,
                "decorations": false,
                "transparent": true,
                "shadow": true,
                "dragDropEnabled": false,
                "visible": false
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self' 'wasm-unsafe-eval'",
                "style-src": "'self' 'unsafe-inline'",
                "font-src": "'self' data:",
                "img-src": "'self' data: blob: https:",
                "connect-src": "'self' ws://127.0.0.1:* http://127.0.0.1:* ipc: http://ipc.localhost https://ai.codai.ro wss://ai.codai.ro https://storage.googleapis.com",
                "media-src": "'self' blob: data: mediastream:",
                "worker-src": "'self' blob:"
            }
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "resources": {
            "resources/sidecar/": "sidecar/",
            "vcam/bin/tiksee_vcam.dll": "tiksee_vcam.dll",
            "vcam/bin/tiksee-vcam-setup.exe": "tiksee-vcam-setup.exe"
        },
        "externalBin": [
            "binaries/tiksee-sidecar"
        ],
        "windows": {
            "nsis": {
                "installMode": "perMachine",
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCMEM2OTY4NEQ5QURFQTAKUldTZzNwcE5hR2tNUzBzUGNGcllwWlJ5QXZRQWVhNkNNUkdycEc3L2IxYVJTQXh3SXFzNFJha2YK",
            "endpoints": [
                "https://storage.googleapis.com/tiksee-releases/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
