# Native/build-script packages we explicitly trust.
# esbuild+rolldown power Vite/tsup; @napi-rs/canvas and serialport are the
# sidecar's native deps; the Tauri CLI unpacks its platform binary on install.
enable-pre-post-scripts=true
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=@tauri-apps/cli
onlyBuiltDependencies[]=@napi-rs/canvas
onlyBuiltDependencies[]=serialport
onlyBuiltDependencies[]=@serialport/bindings-cpp
