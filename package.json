{
    "name": "tiksee",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "TikSee — TikTok LIVE streamer companion for Windows and Android",
    "packageManager": "pnpm@12.9.1",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "clean": "turbo run clean && rimraf node_modules",
        "desktop": "pnpm --filter @tiksee/desktop dev",
        "sidecar": "pnpm --filter @tiksee/sidecar dev",
        "verify": "turbo run typecheck lint test build"
    },
    "devDependencies": {
        "@tiksee/config": "workspace:*",
        "@typescript/native": "catalog:",
        "prettier": "3.9.9",
        "rimraf": "6.1.3",
        "turbo": "2.11.7",
        "typescript": "catalog:"
    }
}
