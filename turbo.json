{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "globalDependencies": [
        "tsconfig.base.json"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "src/**",
                "package.json",
                "tsconfig*.json",
                "vite.config.*",
                "tsup.config.*"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "src/**",
                "package.json",
                "tsconfig*.json"
            ],
            "outputs": []
        },
        "lint": {
            "inputs": [
                "src/**",
                "eslint.config.*",
                "package.json"
            ],
            "outputs": []
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "src/**",
                "package.json",
                "vitest.config.*"
            ],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        }
    }
}