{
  "version": 1,
  "repo": "selfie-screen",
  "trackers": [
    {
      "id": "backlog",
      "file": "docs/backlog.csv",
      "format": "csv",
      "columns": {
        "id": "ID",
        "title": "Title",
        "status": "Status",
        "group": "Workstream",
        "notes": "Notes"
      },
      "status": {
        "map": {
          "Beta": "review",
          "Deferred": "deferred",
          "Done": "done",
          "In progress": "in-progress",
          "Not started": "todo",
          "Partial": "in-progress",
          "Todo": "todo"
        }
      },
      "idPattern": "^WS\\d{2}-\\d{2}$",
      "index": {
        "kind": "plan",
        "order": 0
      }
    }
  ]
}
